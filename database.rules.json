{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      ".read": "auth != null",
      ".indexOn": ["wins"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "history": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".indexOn": ["at"]
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[A-Z0-9]{4}$/)",
        ".write": "auth != null && $code.matches(/^[A-Z0-9]{4}$/)"
      }
    }
  }
}
